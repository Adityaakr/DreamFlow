# Somnia mainnet RPC (public, no key required).
SOMNIA_WS_URL=wss://api.infra.mainnet.somnia.network/ws
SOMNIA_HTTP_URL=https://api.infra.mainnet.somnia.network/

# Optional, server-only. Enables AI-assisted Pulse Agent through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional, server-only. Reserved for future persistence/replay work.
DATABASE_URL=
