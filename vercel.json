{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dreamflow.adibuilds.in/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://dreamflow.adibuilds.in/health"
    },
    {
      "source": "/((?!api/.*|health).*)",
      "destination": "/index.html"
    }
  ]
}
